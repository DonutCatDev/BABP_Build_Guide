# Ignore GitHub metadata and workflow files
# Keep workflows committed so GitHub Pages can build and deploy MkDocs.
.github/copilot-workbench.md

# Raw extracted reference image cache (generated from DOCX).
refs/extracted-media/

# Generated PDF export artifacts from site builds.
site/**/*.pdf

# MkDocs build output and local Python environments/caches.
site/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
